{
  "name": "@raviqqe/loscore",
  "version": "0.3.1",
  "description": "Yet another utility library",
  "license": "MIT",
  "repository": "https://github.com/raviqqe/loscore",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "default": "./dist/async.js"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rslib build",
    "build:doc": "deno doc --unstable-sloppy-imports --html --name='🕹 Loscore' src/index.ts src/async.ts",
    "lint": "biome ci && knip",
    "test": "vitest --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@raviqqe/biome-config": "^2.0.16",
    "@raviqqe/tsconfig": "^3.0.0",
    "@rslib/core": "^0.23.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.0.1",
    "knip": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.1"
  },
  "engines": {
    "node": ">=26.6.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
