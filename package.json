{
  "name": "@raviqqe/loscore",
  "version": "0.3.1",
  "description": "Yet another utility library",
  "license": "MIT",
  "repository": "https://github.com/raviqqe/loscore",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "default": "./dist/async.js"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rslib build",
    "build:doc": "deno doc --unstable-sloppy-imports --html --name='🕹 Loscore' src/index.ts src/async.ts",
    "lint": "biome ci && knip",
    "test": "vitest --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@raviqqe/biome-config": "^2.0.29",
    "@raviqqe/tsconfig": "^3.0.5",
    "@rslib/core": "^1.1.0",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "knip": "^6.48.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
